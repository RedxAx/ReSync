  {
    "id": "resource.build_custom_content",
    "displayName": "Build Custom Content Definition",
    "description": "Build a typed custom item, block, armor, or content definition.",
    "tags": ["resource", "custom", "content", "definition", "builder"],
    "category": "CUSTOM_CONTENT",
    "handler": "ResourceDefinitionHandler",
    "handlerConfig": {"operation": "build_custom_content"},
    "inputs": [
      {"name": "flow", "pinType": "FLOW", "dataType": "execution"},
      {"name": "id", "dataType": "string", "required": true},
      {"name": "display_name", "dataType": "component", "defaultValue": "Custom Content"},
      {"name": "content_type", "dataType": "string", "widget": "DROPDOWN", "options": ["item", "block", "armor", "furniture"], "defaultValue": "item"},
      {"name": "provider", "dataType": "string", "widget": "DROPDOWN", "optionsSource": "server:custom_content:provider", "defaultValue": "vanilla"},
      {"name": "external_id", "dataType": "string", "widget": "SEARCHABLE_LIST", "optionsSource": "server:custom_content:asset"},
      {"name": "material", "dataType": "material", "widget": "SEARCHABLE_LIST", "optionsSource": "server:minecraft:material", "defaultValue": "STICK"},
      {"name": "flow_id", "dataType": "string"},
      {"name": "lore", "dataType": "component", "repeatable": {"groupId": "lore", "minItems": 0, "maxItems": 64, "itemLabel": "Lore"}},
      {"name": "tag", "dataType": "string", "repeatable": {"groupId": "tags", "minItems": 0, "maxItems": 64, "itemLabel": "Tag"}}
    ],
    "outputs": [
      {"name": "flow", "pinType": "FLOW", "dataType": "execution"},
      {"name": "failed", "pinType": "FLOW", "dataType": "execution"},
      {"name": "definition", "dataType": "custom_content_definition"},
      {"name": "result", "dataType": "result<custom_content_definition>"},
      {"name": "success", "dataType": "boolean"},
      {"name": "error_code", "dataType": "string"},
      {"name": "message", "dataType": "string"}
    ]
  },
  {
