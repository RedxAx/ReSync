  {
    "id": "player_count_item",
    "displayName": "Player Count Item",
    "description": "Counts items in a player's storage inventory. An item stack matches material and metadata. A material value or name matches all stacks of that material. Adds the amounts in matching stacks.",
    "domain": "player",
    "family": "queries",
    "lifecycle": "active",
    "handlerCapability": "player.query",
    "selectorIntent": "typed-player",
    "inspectorIntent": "player-query",
    "owner": "restudio.resync",
    "category": "DATA",
    "schemaVersion": 2,
    "kind": "QUERY",
    "tags": [
      "player",
      "queries",
      "query",
      "count",
      "item"
    ],
    "examples": [
      "Provide a player and connect the typed output to a compatible input."
    ],
    "handler": "player_count_item",
    "handlerConfig": {
      "operation": "player_count_item"
    },
    "inputs": [
      {
        "id": "player",
        "displayName": "Player",
        "name": "player",
        "pinType": "DATA",
        "dataType": "player",
        "description": "Online player to inspect. Uses the Flow's current player when this input is omitted.",
        "direction": "input"
      },
      {
        "id": "material_or_item",
        "displayName": "Material Or Item",
        "name": "material_or_item",
        "pinType": "DATA",
        "dataType": "any",
        "description": "Item stack, material value, or material name to count. A stack matches material and metadata. A material value or name matches material alone.",
        "direction": "input"
      }
    ],
    "outputs": [
      {
        "id": "count",
        "displayName": "Count",
        "name": "count",
        "pinType": "DATA",
        "dataType": "number",
        "description": "Total number of matching items across storage stacks.",
        "direction": "output"
      }
    ]
  },
