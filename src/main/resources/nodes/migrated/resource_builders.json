      {"name": "skin_uuid", "dataType": "string", "optional": true},
      {"name": "skin_texture", "dataType": "string", "optional": true},
      {"name": "skin_signature", "dataType": "string", "optional": true},
      {"name": "ai", "dataType": "boolean", "defaultValue": false},
      {"name": "gravity", "dataType": "boolean", "defaultValue": true},
      {"name": "invulnerable", "dataType": "boolean", "defaultValue": true},
      {"name": "follow_player", "dataType": "boolean", "defaultValue": false},
      {"name": "follow_range", "dataType": "number", "defaultValue": 12.0},
      {"name": "main_hand", "dataType": "string", "optional": true},
      {"name": "off_hand", "dataType": "string", "optional": true},
      {"name": "helmet", "dataType": "string", "optional": true},
      {"name": "chestplate", "dataType": "string", "optional": true},
      {"name": "leggings", "dataType": "string", "optional": true},
      {"name": "boots", "dataType": "string", "optional": true},
      {"name": "spawn_flow", "dataType": "string", "optional": true},
      {"name": "interact_flow", "dataType": "string", "optional": true},
      {"name": "right_click_flow", "dataType": "string", "optional": true},
      {"name": "left_click_flow", "dataType": "string", "optional": true},
      {"name": "damage_flow", "dataType": "string", "optional": true},
      {"name": "death_flow", "dataType": "string", "optional": true},
      {"name": "despawn_flow", "dataType": "string", "optional": true},
      {"name": "trade_profile", "dataType": "trade_profile_id", "widget": "SEARCHABLE_LIST", "optionsSource": "server:resync:trade_profile", "optional": true},
      {"name": "dialog", "dataType": "dialog_id", "widget": "SEARCHABLE_LIST", "optionsSource": "server:resync:dialog", "optional": true},
      {"name": "loot_table", "dataType": "loot_table_id", "widget": "SEARCHABLE_LIST", "optionsSource": "server:resync:loot_table", "optional": true},
