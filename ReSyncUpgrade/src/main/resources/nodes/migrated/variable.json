  {
    "id": "variable.variable_access",
    "displayName": "Variable Access",
    "category": "VARIABLE",
    "hiddenReason": "migration-only",
    "deprecated": true,
    "hidden": true,
    "handler": "VariableScopeHandler",
    "handlerConfig": {
      "operation": "variable_access"
    },
    "inputs": [
      {
        "name": "mode",
        "dataType": "string",
        "widget": "DROPDOWN",
        "options": [
          "get",
          "set",
          "delete",
          "list",
          "increment",
          "decrement",
          "multiply",
          "divide",
          "exists"
        ],
        "defaultValue": "get"
      },
      {
        "name": "scope",
        "dataType": "string",
        "widget": "DROPDOWN",
        "options": [
          "local",
          "global",
          "player"
        ],
        "defaultValue": "local"
      },
      {
        "name": "persist",
        "dataType": "boolean"
      },
      {
        "name": "name",
        "dataType": "string",
        "visibleWhen": {
          "mode": "get,set,delete,increment,decrement,multiply,divide,exists"
        }
      },
      {
        "name": "value",
        "dataType": "any",
        "visibleWhen": {
          "mode": "set"
        }
      },
      {
        "name": "amount",
        "dataType": "number",
        "defaultValue": "1",
        "visibleWhen": {
          "mode": "increment,decrement,multiply,divide"
        }
      },
      {
        "name": "player",
        "dataType": "player",
        "visibleWhen": {
          "scope": "player"
        }
      }
    ],
    "outputs": [
      {
        "name": "value",
        "dataType": "any"
      },
      {
        "name": "exists",
        "dataType": "any"
      },
      {
        "name": "variables",
        "dataType": "list<any>"
      }
    ]
  },
