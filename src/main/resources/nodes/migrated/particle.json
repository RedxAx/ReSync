[
  {
    "id": "particle.apply",
    "displayName": "Particle",
    "category": "VISUAL",
    "kind": "FAMILY",
    "handler": "ParticleHandler",
    "handlerConfig": {
      "operation": "particle_apply"
    },
    "aliases": [
      "effect",
      "particles",
      "burst",
      "shape"
    ],
    "inputs": [
      { "name": "flow", "pinType": "FLOW", "dataType": "execution" },
      { "name": "mode", "dataType": "string", "widget": "DROPDOWN", "options": ["point", "burst", "player", "area", "line", "circle", "ring", "sphere", "ellipse", "spiral", "cone", "cube", "wave", "text", "block_dust", "item_break", "explosion"], "defaultValue": "point" },
      { "name": "particle", "dataType": "string", "widget": "SEARCHABLE_LIST", "optionsSource": "server:minecraft:particle", "defaultValue": "FLAME" },
      { "name": "location", "dataType": "location", "visibleWhen": { "mode": "point,burst,player,circle,ring,sphere,ellipse,spiral,cone,text,block_dust,item_break,explosion" } },
      { "name": "player", "dataType": "player", "visibleWhen": { "mode": "player" } },
      { "name": "start_location", "dataType": "location", "visibleWhen": { "mode": "line,wave" } },
      { "name": "end_location", "dataType": "location", "visibleWhen": { "mode": "line" } },
      { "name": "min_location", "dataType": "location", "visibleWhen": { "mode": "area,cube" } },
      { "name": "max_location", "dataType": "location", "visibleWhen": { "mode": "area,cube" } },
      { "name": "count", "dataType": "number", "widget": "NUMBER", "defaultValue": "24", "visibleWhen": { "mode": "point,burst,player,circle,ring,sphere,ellipse,spiral,cone,block_dust" } },
      { "name": "density", "dataType": "number", "widget": "NUMBER", "defaultValue": "10", "visibleWhen": { "mode": "area,line" } },
      { "name": "offset_x", "dataType": "number", "widget": "NUMBER", "defaultValue": "0", "visibleWhen": { "mode": "point,player" } },
      { "name": "offset_y", "dataType": "number", "widget": "NUMBER", "defaultValue": "0", "visibleWhen": { "mode": "point,player" } },
      { "name": "offset_z", "dataType": "number", "widget": "NUMBER", "defaultValue": "0", "visibleWhen": { "mode": "point,player" } },
      { "name": "spread", "dataType": "number", "widget": "NUMBER", "defaultValue": "0.6", "visibleWhen": { "mode": "burst" } },
      { "name": "speed", "dataType": "number", "widget": "NUMBER", "defaultValue": "0.02", "visibleWhen": { "mode": "point,burst,player" } },
      { "name": "radius", "dataType": "number", "widget": "NUMBER", "defaultValue": "3", "visibleWhen": { "mode": "circle,ring,sphere,spiral,cone" } },
      { "name": "radius_x", "dataType": "number", "widget": "NUMBER", "defaultValue": "5", "visibleWhen": { "mode": "ellipse" } },
      { "name": "radius_z", "dataType": "number", "widget": "NUMBER", "defaultValue": "3", "visibleWhen": { "mode": "ellipse" } },
      { "name": "height", "dataType": "number", "widget": "NUMBER", "defaultValue": "5", "visibleWhen": { "mode": "spiral,cone" } },
      { "name": "rotations", "dataType": "number", "widget": "NUMBER", "defaultValue": "3", "visibleWhen": { "mode": "spiral" } },
      { "name": "axis", "dataType": "string", "widget": "DROPDOWN", "options": ["x", "y", "z"], "defaultValue": "y", "visibleWhen": { "mode": "ring" } },
      { "name": "filled", "dataType": "boolean", "widget": "TOGGLE", "defaultValue": "false", "visibleWhen": { "mode": "cube" } },
      { "name": "step", "dataType": "number", "widget": "NUMBER", "defaultValue": "1", "visibleWhen": { "mode": "cube" } },
      { "name": "direction", "dataType": "vector", "visibleWhen": { "mode": "wave" } },
      { "name": "amplitude", "dataType": "number", "widget": "NUMBER", "defaultValue": "1", "visibleWhen": { "mode": "wave" } },
      { "name": "frequency", "dataType": "number", "widget": "NUMBER", "defaultValue": "0.5", "visibleWhen": { "mode": "wave" } },
      { "name": "length", "dataType": "number", "widget": "NUMBER", "defaultValue": "10", "visibleWhen": { "mode": "wave" } },
      { "name": "text", "dataType": "string", "widget": "TEXT", "defaultValue": "Text", "visibleWhen": { "mode": "text" } },
      { "name": "size", "dataType": "number", "widget": "NUMBER", "defaultValue": "0.3", "visibleWhen": { "mode": "text" } },
      { "name": "block_type", "dataType": "string", "widget": "SEARCHABLE_LIST", "optionsSource": "server:minecraft:block", "defaultValue": "STONE", "visibleWhen": { "mode": "block_dust" } },
      { "name": "item_type", "dataType": "string", "widget": "SEARCHABLE_LIST", "optionsSource": "server:minecraft:material", "defaultValue": "STONE", "visibleWhen": { "mode": "item_break" } },
      { "name": "large", "dataType": "boolean", "widget": "TOGGLE", "defaultValue": "false", "visibleWhen": { "mode": "explosion" } }
    ],
    "outputs": [
      { "name": "flow", "pinType": "FLOW", "dataType": "execution" }
    ]
  },
