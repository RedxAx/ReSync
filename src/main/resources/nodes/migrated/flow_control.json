  {
    "id": "loop_while",
    "displayName": "While",
    "description": "Repeat while the condition is true, with optional pacing and a safety limit.",
    "category": "LOGIC",
    "schemaVersion": 2,
    "kind": "ACTION",
    "tags": [
      "loop",
      "while",
      "repeat"
    ],
    "handler": "FlowControlHandler",
    "handlerConfig": {
      "operation": "loop_while"
    },
    "inputs": [
      {
        "name": "flow",
        "pinType": "FLOW",
        "dataType": "execution"
      },
      {
        "name": "condition",
        "dataType": "boolean",
        "defaultValue": true
      },
      {
        "name": "interval_ticks",
        "dataType": "number",
        "defaultValue": 1,
        "constraints": {
          "min": 1
        }
      },
      {
        "name": "max_iterations",
        "dataType": "number",
        "defaultValue": 0,
        "constraints": {
          "min": 0
        }
      }
    ],
    "outputs": [
      {
        "name": "loop",
        "pinType": "FLOW",
        "dataType": "execution"
      },
      {
        "name": "done",
        "pinType": "FLOW",
        "dataType": "execution"
      },
      {
        "name": "completed",
        "dataType": "boolean"
      },
      {
        "name": "index",
        "dataType": "number"
      }
    ]
  },
