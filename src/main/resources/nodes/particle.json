[
  {
    "id": "particle.apply",
    "displayName": "Particle",
    "description": "Spawn particles at a point, around a shape, for a player, or as a text effect.",
    "domain": "particle",
    "family": "particle",
    "lifecycle": "active",
    "handlerCapability": "particle.effect",
    "selectorIntent": "typed-reference",
    "inspectorIntent": "generic",
    "owner": "restudio.resync",
    "category": "VISUAL",
    "schemaVersion": 2,
    "kind": "FAMILY",
    "tags": ["particle", "effect", "shape"],
    "aliases": ["effect", "particles", "burst", "shape"],
    "legacyIds": [
      "particle.spawn",
      "particle.area",
      "particle.player.spawn",
      "particle.line",
      "particle.circle",
      "particle.sphere",
      "particle.ellipse",
      "particle.spiral",
      "particle.cone",
      "particle.ring",
      "particle.cube",
      "particle.wave",
      "particle.text",
      "particle.block.dust",
      "particle.item.break",
      "particle.explosion"
    ],
    "examples": ["Connect Flow, choose a mode and particle, then provide the location inputs shown for that mode."],
    "authorizationPolicy": "trusted_server_flow",
    "handler": "ParticleHandler",
    "handlerConfig": {"operation": "particle_apply"},
    "migrationMapping": {
      "sourceSchemaVersion": 1,
      "targetSchemaVersion": 2,
      "complete": true,
      "pins": [
        {"direction": "input", "source": "flow", "target": "flow"},
        {"direction": "input", "source": "mode", "target": "mode"},
        {"direction": "input", "source": "particle", "target": "particle"},
        {"direction": "input", "source": "location", "target": "location"},
        {"direction": "input", "source": "player", "target": "player"},
        {"direction": "input", "source": "start_location", "target": "start_location"},
        {"direction": "input", "source": "end_location", "target": "end_location"},
        {"direction": "input", "source": "min_location", "target": "min_location"},
        {"direction": "input", "source": "max_location", "target": "max_location"},
        {"direction": "input", "source": "count", "target": "count"},
        {"direction": "input", "source": "density", "target": "density"},
        {"direction": "input", "source": "offset_x", "target": "offset_x"},
        {"direction": "input", "source": "offset_y", "target": "offset_y"},
        {"direction": "input", "source": "offset_z", "target": "offset_z"},
        {"direction": "input", "source": "spread", "target": "spread"},
        {"direction": "input", "source": "speed", "target": "speed"},
        {"direction": "input", "source": "radius", "target": "radius"},
        {"direction": "input", "source": "radius_x", "target": "radius_x"},
        {"direction": "input", "source": "radius_z", "target": "radius_z"},
        {"direction": "input", "source": "height", "target": "height"},
        {"direction": "input", "source": "rotations", "target": "rotations"},
        {"direction": "input", "source": "axis", "target": "axis"},
        {"direction": "input", "source": "filled", "target": "filled"},
        {"direction": "input", "source": "step", "target": "step"},
        {"direction": "input", "source": "direction", "target": "direction"},
        {"direction": "input", "source": "amplitude", "target": "amplitude"},
        {"direction": "input", "source": "frequency", "target": "frequency"},
        {"direction": "input", "source": "length", "target": "length"},
        {"direction": "input", "source": "text", "target": "text"},
        {"direction": "input", "source": "size", "target": "size"},
        {"direction": "input", "source": "block_type", "target": "block_type"},
        {"direction": "input", "source": "item_type", "target": "item_type"},
        {"direction": "input", "source": "large", "target": "large"},
        {"direction": "output", "source": "flow", "target": "output_flow"}
      ]
    },
    "inputs": [
      {"id": "flow", "displayName": "Flow", "name": "flow", "pinType": "FLOW", "dataType": "execution", "direction": "input", "description": "Starts the particle effect when execution reaches this node."},
      {"id": "mode", "displayName": "Mode", "name": "mode", "dataType": "string", "widget": "DROPDOWN", "options": ["point", "burst", "player", "area", "line", "circle", "ring", "sphere", "ellipse", "spiral", "cone", "cube", "wave", "text", "block_dust", "item_break", "explosion"], "defaultValue": "point", "direction": "input", "description": "Chooses the particle shape or effect to spawn."},
      {"id": "particle", "displayName": "Particle", "name": "particle", "dataType": "string", "widget": "SEARCHABLE_LIST", "optionsSource": "server:minecraft:particle", "defaultValue": "FLAME", "direction": "input", "description": "Selects the Minecraft particle type."},
      {"id": "location", "displayName": "Location", "name": "location", "dataType": "location", "visibleWhen": {"mode": "point,burst,player,circle,ring,sphere,ellipse,spiral,cone,text,block_dust,item_break,explosion"}, "direction": "input", "description": "Provides the center or spawn location for the selected mode."},
      {"id": "player", "displayName": "Player", "name": "player", "dataType": "player", "visibleWhen": {"mode": "player"}, "direction": "input", "description": "Selects the player who receives the particle effect in player mode."},
      {"id": "start_location", "displayName": "Start Location", "name": "start_location", "dataType": "location", "visibleWhen": {"mode": "line,wave"}, "direction": "input", "description": "Provides the first point for a line or wave effect."},
      {"id": "end_location", "displayName": "End Location", "name": "end_location", "dataType": "location", "visibleWhen": {"mode": "line"}, "direction": "input", "description": "Provides the last point for a line effect."},
      {"id": "min_location", "displayName": "Minimum Location", "name": "min_location", "dataType": "location", "visibleWhen": {"mode": "area,cube"}, "direction": "input", "description": "Provides the lower corner of an area or cube effect."},
      {"id": "max_location", "displayName": "Maximum Location", "name": "max_location", "dataType": "location", "visibleWhen": {"mode": "area,cube"}, "direction": "input", "description": "Provides the upper corner of an area or cube effect."},
      {"id": "count", "displayName": "Count", "name": "count", "dataType": "number", "widget": "NUMBER", "defaultValue": 24, "constraints": {"min": 0, "max": 10000, "step": 1}, "visibleWhen": {"mode": "point,burst,player,circle,ring,sphere,ellipse,spiral,cone,block_dust"}, "direction": "input", "description": "Sets the particle count for point, burst, player, shape, or block dust modes."},
      {"id": "density", "displayName": "Density", "name": "density", "dataType": "number", "widget": "NUMBER", "defaultValue": 10, "constraints": {"min": 1, "max": 10000, "step": 1}, "visibleWhen": {"mode": "area,line"}, "direction": "input", "description": "Sets the number of samples across area or line effects."},
      {"id": "offset_x", "displayName": "Offset X", "name": "offset_x", "dataType": "number", "defaultValue": 0, "visibleWhen": {"mode": "point,player"}, "direction": "input", "description": "Sets the X spread for point or player particle spawning."},
      {"id": "offset_y", "displayName": "Offset Y", "name": "offset_y", "dataType": "number", "defaultValue": 0, "visibleWhen": {"mode": "point,player"}, "direction": "input", "description": "Sets the Y spread for point or player particle spawning."},
      {"id": "offset_z", "displayName": "Offset Z", "name": "offset_z", "dataType": "number", "defaultValue": 0, "visibleWhen": {"mode": "point,player"}, "direction": "input", "description": "Sets the Z spread for point or player particle spawning."},
      {"id": "spread", "displayName": "Spread", "name": "spread", "dataType": "number", "widget": "NUMBER", "defaultValue": 0.6, "constraints": {"min": 0, "max": 1024}, "visibleWhen": {"mode": "burst"}, "direction": "input", "description": "Sets the uniform burst spread from 0 through 1024 blocks."},
      {"id": "speed", "displayName": "Speed", "name": "speed", "dataType": "number", "widget": "NUMBER", "defaultValue": 0.02, "constraints": {"min": 0, "max": 100}, "visibleWhen": {"mode": "point,burst,player"}, "direction": "input", "description": "Sets particle motion speed from 0 through 100."},
      {"id": "radius", "displayName": "Radius", "name": "radius", "dataType": "number", "widget": "NUMBER", "defaultValue": 3.0, "constraints": {"min": 0, "max": 1024}, "visibleWhen": {"mode": "circle,ring,sphere,spiral,cone"}, "direction": "input", "description": "Sets the radius for circular, spherical, spiral, or cone effects."},
      {"id": "radius_x", "displayName": "Radius X", "name": "radius_x", "dataType": "number", "widget": "NUMBER", "defaultValue": 5.0, "constraints": {"min": 0, "max": 1024}, "visibleWhen": {"mode": "ellipse"}, "direction": "input", "description": "Sets the horizontal radius of an ellipse."},
      {"id": "radius_z", "displayName": "Radius Z", "name": "radius_z", "dataType": "number", "widget": "NUMBER", "defaultValue": 3.0, "constraints": {"min": 0, "max": 1024}, "visibleWhen": {"mode": "ellipse"}, "direction": "input", "description": "Sets the depth radius of an ellipse."},
      {"id": "height", "displayName": "Height", "name": "height", "dataType": "number", "widget": "NUMBER", "defaultValue": 5.0, "constraints": {"min": 0, "max": 1024}, "visibleWhen": {"mode": "spiral,cone"}, "direction": "input", "description": "Sets the vertical height of a spiral or cone effect."},
      {"id": "rotations", "displayName": "Rotations", "name": "rotations", "dataType": "number", "widget": "NUMBER", "defaultValue": 3.0, "constraints": {"min": 0.01, "max": 100}, "visibleWhen": {"mode": "spiral"}, "direction": "input", "description": "Sets the number of spiral rotations from above zero through 100."},
      {"id": "axis", "displayName": "Axis", "name": "axis", "dataType": "string", "widget": "DROPDOWN", "options": ["x", "y", "z"], "defaultValue": "y", "visibleWhen": {"mode": "ring"}, "direction": "input", "description": "Chooses the axis around which a ring is drawn."},
      {"id": "filled", "displayName": "Filled", "name": "filled", "dataType": "boolean", "widget": "TOGGLE", "defaultValue": false, "visibleWhen": {"mode": "cube"}, "direction": "input", "description": "Fills the cube when true. False emits only its boundary."},
      {"id": "step", "displayName": "Step", "name": "step", "dataType": "number", "widget": "NUMBER", "defaultValue": 1.0, "constraints": {"min": 0.1, "max": 1024}, "visibleWhen": {"mode": "cube"}, "direction": "input", "description": "Sets the sample spacing for a cube from 0.1 through 1024 blocks."},
      {"id": "direction", "displayName": "Direction", "name": "direction", "dataType": "vector", "visibleWhen": {"mode": "wave"}, "direction": "input", "description": "Sets the non-zero direction vector for a wave effect."},
      {"id": "amplitude", "displayName": "Amplitude", "name": "amplitude", "dataType": "number", "widget": "NUMBER", "defaultValue": 1.0, "constraints": {"min": -1024, "max": 1024}, "visibleWhen": {"mode": "wave"}, "direction": "input", "description": "Sets the wave displacement from -1024 through 1024 blocks."},
      {"id": "frequency", "displayName": "Frequency", "name": "frequency", "dataType": "number", "widget": "NUMBER", "defaultValue": 0.5, "constraints": {"min": -1000, "max": 1000}, "visibleWhen": {"mode": "wave"}, "direction": "input", "description": "Sets the wave frequency from -1000 through 1000."},
      {"id": "length", "displayName": "Length", "name": "length", "dataType": "number", "widget": "NUMBER", "defaultValue": 10.0, "constraints": {"min": 0, "max": 1024}, "visibleWhen": {"mode": "wave"}, "direction": "input", "description": "Sets the non-negative wave length from 0 through 1024 blocks."},
      {"id": "text", "displayName": "Text", "name": "text", "dataType": "string", "widget": "TEXT", "defaultValue": "Text", "visibleWhen": {"mode": "text"}, "direction": "input", "description": "Sets the text rendered by the particle text effect, up to 80 characters."},
      {"id": "size", "displayName": "Size", "name": "size", "dataType": "number", "widget": "NUMBER", "defaultValue": 0.3, "constraints": {"min": 0.01, "max": 10}, "visibleWhen": {"mode": "text"}, "direction": "input", "description": "Sets the particle text scale from above zero through 10."},
      {"id": "block_type", "displayName": "Block", "name": "block_type", "dataType": "material", "widget": "SEARCHABLE_LIST", "optionsSource": "server:minecraft:block", "defaultValue": "STONE", "visibleWhen": {"mode": "block_dust"}, "direction": "input", "description": "Selects the block material used by block dust."},
      {"id": "item_type", "displayName": "Item", "name": "item_type", "dataType": "material", "widget": "SEARCHABLE_LIST", "optionsSource": "server:minecraft:material", "defaultValue": "stone", "visibleWhen": {"mode": "item_break"}, "direction": "input", "description": "Selects the item material used by item break particles."},
      {"id": "large", "displayName": "Large", "name": "large", "dataType": "boolean", "widget": "TOGGLE", "defaultValue": false, "visibleWhen": {"mode": "explosion"}, "direction": "input", "description": "Uses the larger lava burst when true."}
    ],
    "outputs": [
      {"id": "output_flow", "displayName": "Flow", "name": "flow", "pinType": "FLOW", "dataType": "execution", "direction": "output", "description": "Continues after the particle effect has been spawned."}
    ]
  }
]
