  {
    "id": "text.entries",
    "displayName": "Text Map",
    "description": "Loads the ordered key and value pairs from a saved Text map.",
    "category": "DATA",
    "schemaVersion": 2,
    "kind": "PURE",
    "handler": "TextResourceHandler",
    "handlerConfig": {
      "operation": "entries"
    },
    "inputs": [
      {
        "name": "text_id",
        "displayName": "Text",
        "dataType": "string",
        "optionsSource": "server:resync:text_template"
      }
    ],
    "outputs": [
      {
        "name": "entries",
        "dataType": "map<string,string>"
      }
    ]
  },
  {
    "id": "text.lookup",
    "displayName": "Text Lookup",
    "description": "Finds a value in a saved Text map without caring about letter case.",
    "category": "DATA",
    "schemaVersion": 2,
    "kind": "PURE",
    "handler": "TextResourceHandler",
    "handlerConfig": {
      "operation": "lookup"
