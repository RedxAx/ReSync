[
  {
    "id": "call.function",
    "displayName": "Call Function",
    "description": "Call a function selected directly or resolved from a function name at runtime.",
    "category": "FUNCTION",
    "schemaVersion": 2,
    "kind": "ACTION",
    "tags": [
      "call",
      "function",
      "dynamic",
      "programmatic"
    ],
    "handler": "FunctionHandler",
    "handlerConfig": {
      "operation": "call_function"
    },
    "inputs": [
      {
        "name": "flow",
        "pinType": "FLOW",
        "dataType": "execution"
      },
      {
        "name": "function",
        "dataType": "function",
        "widget": "SEARCHABLE_LIST",
        "optionsSource": "server:resync:function"
      },
      {
        "name": "arguments",
        "dataType": "any",
        "optional": true,
        "description": "For one-input functions, connect the value directly. For multiple inputs, connect Arguments from Add Function Argument."
      },
      {
        "name": "continue_on_failure",
        "dataType": "boolean",
        "widget": "TOGGLE",
        "defaultValue": false,
        "description": "Continue with a failed Result instead of stopping the Flow."
      }
    ],
    "outputs": [
      {
        "name": "flow",
        "pinType": "FLOW",
        "dataType": "execution"
      },
      {
        "name": "results",
        "dataType": "map<string,any>"
      },
      {
        "name": "result",
        "dataType": "result<map<string,any>>"
      }
    ]
  },
  {
    "id": "function.argument",
    "displayName": "Add Function Argument",
    "description": "Add one named value to a dynamic function call. Chain these nodes when the function has multiple inputs.",
    "category": "FUNCTION",
    "schemaVersion": 2,
    "kind": "PURE",
    "tags": ["function", "argument", "input", "dynamic"],
    "handler": "FunctionHandler",
    "handlerConfig": {"operation": "argument"},
    "inputs": [
      {
        "name": "arguments",
        "dataType": "map<string,any>",
        "optional": true,
        "description": "Connect the previous Arguments output when adding another value."
      },
      {
        "name": "name",
        "dataType": "string",
        "description": "The input name declared by the function."
      },
      {
        "name": "value",
        "dataType": "any",
        "description": "The player, item, text, number, or other value to pass."
      }
    ],
    "outputs": [
      {"name": "arguments", "dataType": "map<string,any>"}
    ]
  },
  {
    "id": "function.result_value",
    "displayName": "Get Function Result",
    "description": "Read one named output from a dynamically selected function.",
    "category": "FUNCTION",
    "schemaVersion": 2,
    "kind": "PURE",
    "tags": ["function", "result", "output", "dynamic"],
    "handler": "FunctionHandler",
    "handlerConfig": {"operation": "result"},
    "inputs": [
      {"name": "results", "dataType": "map<string,any>"},
      {
        "name": "name",
        "dataType": "string",
        "description": "The output name declared by the function."
      }
    ],
    "outputs": [
      {"name": "value", "dataType": "any"}
    ]
  },
