[
  {
    "id": "debug.log",
    "displayName": "Debug Log",
    "description": "Write a diagnostic message to the ReSync log at the selected level.",
    "domain": "debug",
    "family": "logging",
    "lifecycle": "active",
    "handlerCapability": "debug",
    "selectorIntent": "none",
    "inspectorIntent": "generic",
    "owner": "restudio.resync",
    "category": "UTILITY",
    "schemaVersion": 2,
    "kind": "ACTION",
    "hidden": true,
    "hiddenReason": "Diagnostic node retained for flow compatibility and troubleshooting.",
    "tags": ["debug", "log", "diagnostic"],
    "aliases": ["Log Message", "Debug Message"],
    "handler": "DebugHandler",
    "handlerConfig": {"operation": "debug_log"},
    "inputs": [
      {"id": "flow", "direction": "input", "displayName": "Flow", "name": "flow", "pinType": "FLOW", "dataType": "execution", "description": "Starts the diagnostic log operation."},
      {"id": "message", "direction": "input", "displayName": "Message", "name": "message", "pinType": "DATA", "dataType": "string", "defaultValue": "", "description": "Provides the message written to the ReSync log."},
      {"id": "level", "direction": "input", "displayName": "Level", "name": "level", "pinType": "DATA", "dataType": "string", "widget": "DROPDOWN", "options": ["INFO", "WARN", "ERROR"], "defaultValue": "INFO", "description": "Selects the diagnostic log level."}
    ],
    "outputs": [
      {"id": "output_flow", "direction": "output", "displayName": "Flow", "name": "flow", "pinType": "FLOW", "dataType": "execution", "description": "Continues after the message is logged."}
    ]
  },
