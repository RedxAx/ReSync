  {
    "id": "custom_content.cooldown",
    "displayName": "Content Cooldown",
    "description": "Reads the active cooldown for one custom-content event with values ready for progress bars, countdown text, animations, and branching.",
    "category": "CUSTOM_CONTENT",
    "kind": "QUERY",
    "handler": "CustomContentHandler",
    "handlerConfig": {
      "operation": "content_cooldown_state"
    },
    "inputs": [
      {"name": "flow", "pinType": "FLOW", "dataType": "execution"},
      {"name": "player", "dataType": "player", "optional": true},
      {"name": "content_id", "dataType": "string", "widget": "SEARCHABLE_LIST", "optionsSource": "server:resync:custom_content"},
      {"name": "trigger", "dataType": "string", "defaultValue": "item.use"},
      {"name": "instance_id", "dataType": "string", "optional": true}
    ],
    "outputs": [
      {"name": "ready", "pinType": "FLOW", "dataType": "execution"},
      {"name": "cooldown", "pinType": "FLOW", "dataType": "execution"},
      {"name": "supported", "dataType": "boolean"},
      {"name": "is_ready", "dataType": "boolean"},
      {"name": "remaining_ticks", "dataType": "number"},
      {"name": "remaining_seconds", "dataType": "number"},
      {"name": "elapsed_ticks", "dataType": "number"},
      {"name": "cooldown_ticks", "dataType": "number"},
      {"name": "progress", "dataType": "number"},
      {"name": "progress_percent", "dataType": "number"},
      {"name": "current_tick", "dataType": "number"},
      {"name": "ready_tick", "dataType": "number"},
      {"name": "scope", "dataType": "string"},
      {"name": "key", "dataType": "string"},
      {"name": "trigger", "dataType": "string"}
    ]
  },
