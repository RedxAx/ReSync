        {"direction": "output", "source": "results", "target": "results"},
        {"direction": "output", "source": "result", "target": "result"}
      ]
    },
    "inputs": [
      {"id": "flow", "displayName": "Flow", "name": "flow", "pinType": "FLOW", "direction": "input", "dataType": "execution", "description": "Starts the function call when execution reaches this node."},
      {"id": "function", "displayName": "Function", "name": "function", "direction": "input", "dataType": "function", "widget": "SEARCHABLE_LIST", "optionsSource": "server:resync:function", "description": "Selects the callable Function to execute."},
      {"id": "arguments", "displayName": "Arguments", "name": "arguments", "direction": "input", "dataType": "any", "optional": true, "description": "Provides named Function arguments. A single input may be connected directly. Multiple inputs should use Add Function Argument nodes."},
      {"id": "continue_on_failure", "displayName": "Continue On Failure", "name": "continue_on_failure", "direction": "input", "dataType": "boolean", "widget": "TOGGLE", "defaultValue": false, "description": "Keeps the Flow moving with a failed Result instead of stopping at a function failure."}
