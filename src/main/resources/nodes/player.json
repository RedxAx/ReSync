  {
    "id": "player.actions",
    "displayName": "Player Actions",
    "description": "Changes one selected player property or runs a supported action. The property determines the Value type and which actions are available.",
    "domain": "player",
    "family": "actions",
    "lifecycle": "active",
    "handlerCapability": "player.actions",
    "selectorIntent": "player-action",
    "inspectorIntent": "player-action",
    "owner": "restudio.resync",
    "category": "PLAYER",
    "schemaVersion": 2,
    "kind": "FAMILY",
    "tags": [
      "player",
      "actions",
      "family"
    ],
    "examples": [
      "Connect Flow, provide the player inputs, then continue from the Flow output."
    ],
    "handler": "player",
    "handlerConfig": {
      "operation": "set"
    },
    "inputs": [
      {
        "id": "flow",
        "displayName": "Flow",
        "name": "flow",
        "pinType": "FLOW",
        "dataType": "execution",
        "description": "Starts Player Actions when execution reaches this node.",
        "direction": "input"
      },
      {
        "id": "target",
        "displayName": "Target",
        "name": "target",
        "pinType": "DATA",
        "dataType": "player",
        "description": "Player to change. Uses the Flow's current player when this input is omitted.",
        "direction": "input"
      },
      {
        "id": "action",
        "displayName": "Action",
        "name": "action",
        "pinType": "DATA",
        "dataType": "string",
        "description": "Set writes Value. Do or Execute runs an action supported by the selected property.",
        "direction": "input",
        "widget": "DROPDOWN",
        "options": [
          "set",
          "do",
          "execute"
        ],
        "defaultValue": "set"
      },
      {
        "id": "property",
        "displayName": "Property",
        "name": "property",
        "pinType": "DATA",
        "dataType": "string",
        "description": "Player property or action to use.",
        "direction": "input",
        "widget": "SEARCHABLE_LIST",
        "options": [
          "location",
          "health",
          "max_health",
          "food_level",
          "gamemode",
          "sneak",
          "fly",
          "name",
          "uuid",
          "world",
