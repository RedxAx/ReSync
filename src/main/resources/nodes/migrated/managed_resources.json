  {
    "id": "resource.delete",
    "displayName": "Delete Resource",
    "category": "UTILITY",
    "description": "Preview or delete a managed resource through its authoritative service.",
    "tags": ["delete", "managed", "preview", "resource"],
    "examples": ["Keep Preview enabled to inspect the target, then disable it only when deletion is intended."],
    "authorizationPolicy": "trusted_server_flow",
    "destructive": true,
    "auditPolicy": "resource_mutation",
    "confirmationPolicy": "preview_required",
    "handler": "ReSyncRuntimeResourceHandler",
    "handlerConfig": { "operation": "resource_delete" },
    "inputs": [
      { "name": "flow", "pinType": "FLOW", "dataType": "execution" },
      { "name": "reference", "dataType": "resource_reference", "optional": true },
      { "name": "resource_type", "dataType": "string", "widget": "SEARCHABLE_LIST", "optionsSource": "server:resync:resource_kind", "optional": true },
      { "name": "resource_id", "dataType": "string", "optional": true },
      { "name": "preview", "dataType": "boolean", "defaultValue": "true", "description": "Inspect the deletion without changing the resource." }
    ],
    "outputs": [
      { "name": "flow", "pinType": "FLOW", "dataType": "execution" },
      { "name": "failed", "pinType": "FLOW", "dataType": "execution" },
      { "name": "reference", "dataType": "resource_reference" },
      { "name": "preview", "dataType": "boolean" },
      { "name": "would_delete", "dataType": "boolean" },
      { "name": "changed", "dataType": "boolean" },
      { "name": "deleted", "dataType": "boolean" },
      { "name": "refresh_succeeded", "dataType": "boolean" },
      { "name": "result", "dataType": "result<resource_reference>" },
      { "name": "success", "dataType": "boolean" },
      { "name": "error_code", "dataType": "string" },
      { "name": "message", "dataType": "string" }
    ]
  },
