[
  {
    "id": "player.properties",
    "displayName": "Player Properties",
    "description": "Reads one player property. Populates only the output for that property.",
    "domain": "player",
    "family": "properties",
    "lifecycle": "active",
    "handlerCapability": "player.properties",
    "selectorIntent": "player-property",
    "inspectorIntent": "player-property",
    "owner": "restudio.resync",
    "category": "PLAYER",
    "schemaVersion": 2,
    "kind": "QUERY",
    "tags": [
      "player",
      "properties",
      "query"
    ],
    "examples": [
      "Provide a player, choose a property, and connect the typed output."
    ],
    "handler": "player",
    "handlerConfig": {
      "operation": "get"
    },
    "inputs": [
      {
        "id": "target",
        "displayName": "Target",
        "name": "target",
        "pinType": "DATA",
        "dataType": "player",
        "description": "Player to inspect. Uses the Flow's current player when this input is omitted.",
        "direction": "input"
      },
      {
        "id": "action",
        "displayName": "Action",
        "name": "action",
        "pinType": "DATA",
        "dataType": "string",
        "description": "Get returns the property value. Has checks whether it is present.",
        "direction": "input",
        "widget": "DROPDOWN",
        "options": [
          "get",
          "has"
        ],
        "defaultValue": "get"
      },
      {
        "id": "property",
        "displayName": "Property",
        "name": "property",
        "pinType": "DATA",
        "dataType": "string",
        "description": "Player property to read.",
        "direction": "input",
        "widget": "SEARCHABLE_LIST",
        "options": [
          "location",
          "health",
          "max_health",
          "food_level",
          "gamemode",
          "sneak",
          "fly",
          "name",
          "uuid",
          "world",
          "inventory",
          "item_in_hand",
          "display_name",
          "xp_level",
          "walk_speed",
          "fly_speed",
          "exp",
          "total_exp",
          "exp_to_level",
          "allow_flight",
          "on_ground",
          "sleeping",
          "bed_spawn_location",
          "last_damage",
          "killer",
          "ping",
          "player_list_name",
          "op",
          "offhand_item",
          "saturation",
          "exhaustion",
          "sprint",
          "vanish",
          "glowing",
          "invulnerable",
          "fire_ticks",
          "freeze_ticks",
          "no_damage_ticks",
          "remaining_air",
          "max_air",
          "xp_progress",
          "compass_target",
          "ip",
          "is_flying",
          "online",
          "whitelisted",
          "banned",
          "sleep_ticks",
          "locale",
          "view_distance",
          "is_op",
          "item_in_offhand",
          "armor"
        ],
        "defaultValue": "location"
      }
    ],
    "outputs": [
      {
        "id": "has",
        "displayName": "Has",
        "name": "has",
        "pinType": "DATA",
        "dataType": "boolean",
        "description": "Reports whether the requested player value is available.",
        "direction": "output",
        "visibleWhen": {
          "action": "has"
        }
      },
      {
        "id": "location",
        "displayName": "Location",
        "name": "location",
        "pinType": "DATA",
        "dataType": "location",
        "description": "Current world position, yaw, and pitch of the player.",
        "direction": "output",
        "visibleWhen": {
          "action": "get",
          "property": "location"
        }
      },
      {
        "id": "health",
        "displayName": "Health",
        "name": "health",
        "pinType": "DATA",
        "dataType": "number",
        "description": "Current health in health points. Two points equal one heart.",
        "direction": "output",
        "visibleWhen": {
          "action": "get",
          "property": "health"
        }
      },
      {
        "id": "max_health",
        "displayName": "Max Health",
        "name": "max_health",
        "pinType": "DATA",
        "dataType": "number",
        "description": "Effective maximum health in health points, including attribute modifiers.",
        "direction": "output",
        "visibleWhen": {
          "action": "get",
          "property": "max_health"
        }
      },
      {
