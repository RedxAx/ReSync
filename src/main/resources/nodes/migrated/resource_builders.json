[
  {
    "id": "resource.build_gui",
    "displayName": "Build GUI Definition",
    "description": "Build a typed persistent GUI definition without raw JSON.",
    "tags": ["resource", "gui", "definition", "builder"],
    "category": "MENU",
    "handler": "ResourceDefinitionHandler",
    "handlerConfig": {"operation": "build_gui"},
    "inputs": [
      {"name": "flow", "pinType": "FLOW", "dataType": "execution"},
      {"name": "id", "dataType": "string", "required": true},
      {"name": "title", "dataType": "string", "defaultValue": "Menu"},
      {"name": "rows", "dataType": "integer", "widget": "NUMBER", "defaultValue": 3},
      {"name": "extend_to_inventory", "dataType": "boolean", "defaultValue": false},
      {"name": "click_sound", "dataType": "sound", "optionsSource": "server:minecraft:sound", "defaultValue": "UI_BUTTON_CLICK"},
      {"name": "open_flow", "dataType": "string"},
      {"name": "close_flow", "dataType": "string"}
    ],
    "outputs": [
      {"name": "flow", "pinType": "FLOW", "dataType": "execution"},
      {"name": "failed", "pinType": "FLOW", "dataType": "execution"},
      {"name": "definition", "dataType": "gui_definition"},
      {"name": "result", "dataType": "result<gui_definition>"},
      {"name": "success", "dataType": "boolean"},
      {"name": "error_code", "dataType": "string"},
      {"name": "message", "dataType": "string"}
    ]
  },
