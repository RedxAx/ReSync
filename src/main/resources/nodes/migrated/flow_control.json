  {
    "id": "flow.switch_case",
    "displayName": "Switch Case",
    "description": "Keep Create Branches off to find a matching index. Turn it on to add editable cases with one execution output per case.",
    "category": "LOGIC",
    "schemaVersion": 2,
    "kind": "ACTION",
    "tags": [
      "switch",
      "case",
      "match"
    ],
    "handler": "FlowControlHandler",
    "handlerConfig": {
      "operation": "switch_case"
    },
    "inputs": [
      {
        "name": "flow",
        "pinType": "FLOW",
        "dataType": "execution"
      },
      {
        "name": "branch",
        "dataType": "boolean",
        "widget": "TOGGLE",
        "defaultValue": false,
        "description": "Create one editable execution branch for every case."
      },
      {
        "name": "value",
        "dataType": "type:t"
      },
      {
        "name": "cases",
        "dataType": "list<type:t>",
        "visibleWhen": {
          "branch": "false"
        }
      },
      {
        "name": "case",
        "dataType": "type:t",
        "visibleWhen": {
          "branch": "true"
        },
        "repeatable": {
          "groupId": "cases",
          "minItems": 1,
          "maxItems": 128,
          "itemLabel": "Case"
        }
      }
    ],
    "outputs": [
      {
        "name": "flow",
        "pinType": "FLOW",
        "dataType": "execution",
        "visibleWhen": {
          "branch": "false"
        }
      },
      {
        "name": "case",
        "pinType": "FLOW",
        "dataType": "execution",
        "visibleWhen": {
          "branch": "true"
        },
        "repeatable": {
          "groupId": "cases",
          "minItems": 1,
          "maxItems": 128,
          "itemLabel": "Case"
        }
      },
      {
        "name": "default",
        "pinType": "FLOW",
        "dataType": "execution",
        "visibleWhen": {
          "branch": "true"
        }
      },
      {
        "name": "matched",
        "dataType": "boolean",
        "visibleWhen": {
          "branch": "false"
        }
      },
      {
        "name": "index",
        "dataType": "number",
        "visibleWhen": {
          "branch": "false"
        }
      }
    ]
  },
